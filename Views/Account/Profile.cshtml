@model ExhibitionEntrySystem.Models.ProfileViewModel

@{
    ViewData["Title"] = "Мой профиль";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Личные данные</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle" style="font-size: 5rem;"></i>
                        <h5 class="mt-2">@Model.User.FullName</h5>
                        <span class="badge bg-@(Model.User.Role switch {
                            "Admin" => "danger",
                            "KPP" => "warning",
                            _ => "success"
                        })">
                            @(Model.User.Role switch {
                                "Admin" => "Администратор",
                                "KPP" => "Сотрудник КПП",
                                _ => "Пользователь"
                            })
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Email</label>
                        <p class="h6">@Model.User.Email</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Телефон</label>
                        <p class="h6">@Model.User.PhoneNumber</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Дата регистрации</label>
                        <p class="h6">@Model.User.CreatedAt.ToString("dd.MM.yyyy")</p>
                    </div>

                    @if (Model.User.LastLoginAt.HasValue)
                    {
                        <div class="mb-3">
                            <label class="text-muted small">Последний вход</label>
                            <p class="h6">@Model.User.LastLoginAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="EditProfile" class="btn btn-outline-primary">
                            <i class="bi bi-pencil"></i> Редактировать профиль
                        </a>
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary">
                            <i class="bi bi-key"></i> Сменить пароль
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Мои пропуска</h5>
                    <span class="badge bg-light text-dark">Всего: @Model.Passes.Count</span>
                </div>
                <div class="card-body">
                    @if (!Model.Passes.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-ticket" style="font-size: 3rem; color: #6c757d;"></i>
                            <p class="mt-3 text-muted">У вас пока нет пропусков</p>
                            <a href="/" class="btn btn-primary">Забронировать пропуск</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Павильон</th>
                                        <th>Дата и время</th>
                                        <th>Статус</th>
                                        <th>Транспорт</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pass in Model.Passes)
                                    {
                                        <tr>
                                            <td>@pass.Id</td>
                                            <td>@pass.Pavilion?.Name</td>
                                            <td>
                                                @pass.StartTime.ToString("dd.MM.yyyy")<br>
                                                <small>@pass.StartTime.ToString("HH:mm") - @pass.EndTime.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(pass.Status switch {
                                                    "Сформирован" => "success",
                                                    "Въехал" => "warning",
                                                    "Выехал" => "secondary",
                                                    _ => "info"
                                                })">
                                                    @pass.Status
                                                </span>
                                            </td>
                                            <td>
                                                @pass.Vehicle?.LicensePlate<br>
                                                <small>@pass.Vehicle?.VehicleType</small>
                                            </td>
                                            <td>
                                                <a asp-action="PassDetails" asp-route-id="@pass.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-qr-code"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (userRole == "Admin" || userRole == "KPP")
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Панель управления</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-3 flex-wrap">
                            @if (userRole == "Admin")
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-danger">
                                    <i class="bi bi-shield-lock"></i> Панель администратора
                                </a>
                            }
                            @if (userRole == "KPP" || userRole == "Admin")
                            {
                                <a asp-controller="Checkpoint" asp-action="Index" class="btn btn-warning">
                                    <i class="bi bi-building"></i> Рабочее место КПП
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>