@model ExhibitionEntrySystem.Models.Booking

@{
    ViewData["Title"] = "Пропуск создан";
    var scanUrl = Url.Action("Auth", "Checkpoint", new { key = ViewBag.SecretKey ?? ViewBag.PassId }, Context.Request.Scheme);
}

<div class="card mx-auto mt-5" style="max-width: 500px;">
    <div class="card-header bg-success text-white text-center">
        <h4>Пропуск успешно создан</h4>
    </div>

    <div class="card-body text-center">
        <p><strong>ID пропуска:</strong> @ViewBag.PassId</p>

        <img src="@ViewBag.QRCode" alt="QR Code" class="img-fluid mb-3" />

        <div class="mt-2 mb-3 p-2 bg-light rounded">
            <small class="text-muted d-block">Ссылка для сканирования:</small>
            <div class="d-flex align-items-center justify-content-between">
                <small class="text-break">@scanUrl</small>
                <button class="btn btn-sm btn-outline-primary ms-2" onclick="copyLink()">📋</button>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a href="@ViewBag.QRCode" target="_blank" class="btn btn-primary">
                Открыть QR в новом окне
            </a>
            <a href="/" class="btn btn-outline-secondary">
                На главную
            </a>
        </div>
    </div>
</div>

<script>
    function copyLink() {
        navigator.clipboard.writeText('@scanUrl');
        alert('Ссылка скопирована!');
    }
</script>