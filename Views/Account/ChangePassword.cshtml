@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow theme-aware-card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-key"></i> Смена пароля</h4>
                </div>
                <div class="card-body p-4">
                    @if (ViewData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> @ViewData["Success"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="text-danger"></div>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold theme-aware-text">Текущий пароль</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input type="password" name="currentPassword" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold theme-aware-text">Новый пароль</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input type="password" name="newPassword" class="form-control" required />
                            </div>
                            <small class="text-muted">Минимум 6 символов</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold theme-aware-text">Подтвердите новый пароль</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-key-fill"></i>
                                </span>
                                <input type="password" name="confirmPassword" class="form-control" required />
                            </div>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-warning btn-lg text-dark">
                                <i class="bi bi-check-circle"></i> Сменить пароль
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к профилю
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body.dark-theme .theme-aware-card {
        background-color: #2d2d2d;
        color: #f8f9fa;
        border-color: #495057;
    }

    body.dark-theme .form-control {
        background-color: #2b3644;
        color: #ffffff;
        border-color: #3b4757;
    }

    body.dark-theme .input-group-text {
        background-color: #2b3644;
        color: #ffffff;
        border-color: #3b4757;
    }

    body.dark-theme .text-muted {
        color: #adb5bd !important;
    }
</style>